{
  "name": "@unravel-team/nitrate",
  "version": "0.2.0",
  "private": false,
  "description": "Collaboration for AI video agencies: one campaign brief out, every creator result back in context.",
  "type": "commonjs",
  "bin": {
    "nitrate": "bin/nitrate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "lib/nitrate-client.mjs",
    "mcp/",
    "plugins/",
    "worker/",
    "migrations/",
    "docs/openapi.yaml",
    "ARCHITECTURE.md",
    "DESIGN.md",
    "PRODUCT.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "build:pages": "node scripts/build-agent-pages.mjs",
    "build:plugins": "node scripts/build-plugin-bundles.mjs",
    "verify:plugins": "node scripts/verify-plugins.mjs",
    "verify:worker": "node scripts/verify-worker.mjs",
    "verify": "npm run build:pages && npm test && npm run verify:plugins && npm run verify:worker",
    "prepack": "npm run build:plugins && npm run verify:plugins",
    "worker:dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply nitrate --local"
  },
  "keywords": [
    "ai-media",
    "cloudflare",
    "r2",
    "d1",
    "claude-code",
    "codex",
    "mcp"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/unravel-team/nitrate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unravel-team/nitrate.git"
  },
  "bugs": {
    "url": "https://github.com/unravel-team/nitrate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.22.0",
    "zod": "^4.5.4",
    "wrangler": "^4.128.0"
  }
}
