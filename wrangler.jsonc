{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nitrate",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nitrate",
      "database_id": "a2ea4c5e-dfb2-4508-b48a-95d447cfec79"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nitrate-media"
    }
  ],
  "vars": {
    "NITRATE_PUBLIC_BASE_URL": "https://nitrate.techtools-1be.workers.dev"
  }
}
