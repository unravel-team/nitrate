{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nitrate",
  "account_id": "109e58aae44502c4009b0028538fc329",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/healthz"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nitrate",
      "database_id": "239ccef4-29bf-4038-89bf-34f6143cdfc0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nitrate-media"
    }
  ],
  "vars": {
    "NITRATE_PUBLIC_BASE_URL": "https://nitrate.unravel-tech.workers.dev"
  }
}
